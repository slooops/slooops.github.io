// Minimal Cypress pipeline (UI2.0 branch only) using specified Docker image and hardcoded generic credentials.

pipeline {
  agent {
    docker {
      image 'containers.cisco.com/epit/cypress:v1.0.0'
      // Add any required args (e.g. user permissions) here if needed: args '-u root:root'
    }
  }

  environment {
    TEST_BASE_URL = 'https://operations-control-tower-stg.cisco.com'
    GENERIC_STAGE_USER = 'ctltwr_cypress.gen@stage.cisco.com'
    GENERIC_STAGE_PASS = 'Uitesting@2025'
  }

  stages {
    stage('Branch Validation') {
      when { not { branch 'UI2.0' } }
      steps {
        script {
          echo "Skipping - only runs on UI2.0 branch (current: ${env.BRANCH_NAME})"
          currentBuild.result = 'ABORTED'
        }
      }
    }

    stage('Checkout & Install') {
      when { branch 'UI2.0' }
      steps {
        checkout scm
        dir('revenue-monitoring-ui/angular-app') {
          sh 'node --version || true'
          sh 'npm --version || true'
          sh 'npm ci || (rm -rf node_modules package-lock.json && npm install)'
        }
      }
    }

    stage('Run Cypress Tests') {
      when { branch 'UI2.0' }
      steps {
        dir('revenue-monitoring-ui/angular-app') {
          script {
            echo 'Executing Cypress specs...'
            // Run directly inside the Cypress-enabled image
            def exitCode = sh(returnStatus: true, script: """
              npx cypress run \
                --browser chrome --headless \
                --env baseUrl=${TEST_BASE_URL},genericUsername=${GENERIC_STAGE_USER},genericPassword=${GENERIC_STAGE_PASS} \
                --spec 'cypress/e2e/**/*.cy.ts' \
                --config video=false
            """)
            if (exitCode != 0) {
              error "Cypress tests failed (exit ${exitCode})"
            } else {
              echo 'Cypress tests passed.'
            }
          }
        }
      }
    }
  }

  post {
    always {
      script {
        // Archive screenshots/videos if produced
        archiveArtifacts artifacts: 'revenue-monitoring-ui/angular-app/cypress/screenshots/**/*.png', allowEmptyArchive: true
        archiveArtifacts artifacts: 'revenue-monitoring-ui/angular-app/cypress/videos/**/*.mp4', allowEmptyArchive: true
      }
    }
  }
}