import { ComponentFixture, TestBed } from '@angular/core/testing';
import { InvoiceTrackerComponent } from './invoice-tracker.component';

describe('InvoiceTrackerComponent', () => {
  let component: InvoiceTrackerComponent;
  let fixture: ComponentFixture<InvoiceTrackerComponent>;

  beforeEach(async () => {
    await TestBed.configureTestingModule({
      imports: [InvoiceTrackerComponent],
    }).compileComponents();

    fixture = TestBed.createComponent(InvoiceTrackerComponent);
    component = fixture.componentInstance;
    fixture.detectChanges();
  });

  it('should create', () => {
    expect(component).toBeTruthy();
  });

  it('should initialize with empty visibleTabs', () => {
    expect(component.visibleTabs).toBeDefined();
    expect(Array.isArray(component.visibleTabs)).toBe(true);
  });

  it('should have selectedIndex initialized to 0', () => {
    expect(component.selectedIndex).toBe(0);
  });

  it('should load userContext on init', () => {
    const userContext = component.userContextData;
    expect(userContext).toBeDefined();
    expect(userContext.userId).toBeDefined();
  });
});
