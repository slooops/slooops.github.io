const stackedData: StackedBarChartDataPoint[] = [
  {
    label: 'Q1',
    segments: [
      { name: 'Matched', value: 120, color: '#6ebe4a' },
      { name: 'Not Matched', value: 45, color: '#ff6384' },
      { name: 'Analyzed', value: 30, color: '#36a2eb' },
    ],
  },
  {
    label: 'Q2',
    segments: [
      { name: 'Matched', value: 150, color: '#6ebe4a' },
      { name: 'Not Matched', value: 35, color: '#ff6384' },
      { name: 'Analyzed', value: 25, color: '#36a2eb' },
    ],
  },
  {
    label: 'Q3',
    segments: [
      { name: 'Matched', value: 180, color: '#6ebe4a' },
      { name: 'Not Matched', value: 28, color: '#ff6384' },
      { name: 'Analyzed', value: 20, color: '#36a2eb' },
    ],
  },
  {
    label: 'Q4',
    segments: [
      { name: 'Matched', value: 200, color: '#6ebe4a' },
